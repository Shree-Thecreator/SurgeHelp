# Root ignore for SurgeHelp monorepo

# Node artifacts
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/.turbo/

# Local environment files
*.env
*.env.local
*.env.*.local
backend/.env

# Python artifacts
backend/__pycache__/
backend/*.pyc

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# System files
.DS_Store
Thumbs.db
